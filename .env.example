# Ядро «Астрокосмос» — пример переменных окружения.
# Скопируйте в .env и заполните реальными значениями. Файл .env в git не коммитится.

# --- Приложение ---
APP_NAME=Astrocosmos
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Автозапуск слотов крутится в процессе ядра (без Redis на стенде)
# SCHEDULE_TICKER_ENABLED=true
# SCHEDULE_TICK_SECONDS=20

# Учебный стенд: комплексы «на связи» без Raspberry Pi. В зале поставьте false.
HALL_EMULATOR_ENABLED=true
# HALL_EMULATOR_SECONDS=10

# SQLite для локальной разработки. В Docker — postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./data/astrocosmos.db

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=astrocosmos
POSTGRES_USER=astrocosmos
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- MQTT (Mosquitto), только локальная сеть ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=astroc

# --- NFS / медиа ---
# Локально — папка рядом с БД. В зале / Docker — общий диск, например /media/content
MEDIA_ROOT=./data/media
NFS_EXPORT_PATH=/media/content

# --- Home Assistant (свет, жалюзи). Пустой URL = комфорт выключен ---
HA_BASE_URL=
HA_TOKEN=

# --- Интеграция с обсерваторным «Диптихом» (свой брокер, OpenAPI позже) ---
OBSERVATORY_API_BASE_URL=https://observatory.local/api
OBSERVATORY_API_TOKEN=
OBSERVATORY_TIMEOUT_SECONDS=15
OBSERVATORY_WEBHOOK_SECRET=

# --- Речь (настольный Диптих): офлайн по умолчанию ---
STT_ENGINE=vosk
TTS_ENGINE=piper
YANDEX_SPEECHKIT_API_KEY=
# LLM на этапе MVP не обязателен; включается позже
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
