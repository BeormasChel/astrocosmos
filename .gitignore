# --- Секреты и окружение ---
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.log
*.db
backend/data/*.db
!backend/data/.gitkeep

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
kiosk/dist/
kiosk/.vite/
