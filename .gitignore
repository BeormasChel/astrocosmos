# --- Docker / runtime ---
*.pid
docker/data/
postgres-data/
redis-data/
mosquitto/data/
mosquitto/log/

# --- Медиа и контент (хранятся на NFS/SSD, не в git) ---
media/content/
media/uploads/
backend/data/media/**
!backend/data/media/.gitkeep
*.mp4
*.mov
*.mkv
*.avi
*.unitypackage
clients/holobox/unity_project/

# --- ESP32 / PlatformIO ---
microcontrollers/**/.pio/
microcontrollers/**/.vscode/
microcontrollers/**/platformio_override.ini
*.elf
*.bin
*.map

# --- Raspberry Pi образы и кэш ---
*.img
*.iso

# --- IDE и ОС ---
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# --- Тесты и отчёты ---
.hypothesis/
coverage/
playwright-report/
